{
  "name": "techprep-ai",
  "version": "1.0.0",
  "description": "TechPrep AI - Full Stack Developer Platform",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "vite",
    "seed": "npm --prefix backend run seed",
    "worker": "npm --prefix backend run worker",
    "test": "node --test tests/dom/*.test.mjs",
    "test:api": "npm --prefix backend run test:api",
    "install:backend": "npm --prefix backend install",
    "build": "vite build",
    "dev:backend": "npm --prefix backend run dev",
    "preview": "vite preview --host 0.0.0.0",
    "test:ui": "playwright test --ui",
    "check": "npm run build && npm test",
    "test:browser": "playwright test",
    "format": "prettier --write frontend/src tests vite.config.mjs playwright.config.mjs tailwind.config.cjs postcss.config.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6"
  }
}
